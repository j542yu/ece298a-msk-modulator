* ****************************************************************************
* *** Equivalent LTSpice Model of a N+ Diode
* ****************************************************************************
.subckt LTS_DIODE_N NP NN darea=0 dperi=0 mp=0

.param gf_Level=3
.param gf_Cj=0.00096797
.param gf_Mj=0.32071
.param gf_Pb=0.70172
.param gf_Cjsw=1.5663e-010
.param gf_Mjsw=0.1
.param gf_Php=0.8062
.param gf_Cta=0.0009438
.param gf_Ctp=0.00060474
.param gf_Tpb=0.0018129
.param gf_Tphp=5e-005
.param gf_Tlevc=1
.param gf_Tref=25

.model dio_lts_modn d
+ Cj   = 'gf_Cj   * (1.0 + gf_Cta * (TEMP - gf_Tref))'
+ Cjsw = 'gf_Cjsw * (1.0 + gf_Ctp * (TEMP - gf_Tref))'
+ Mj   = 'gf_Mj'
+ Mjsw = 'gf_Mjsw'
+ Vj   = 'gf_Pb  - gf_Tpb  * (TEMP - gf_Tref)'
+ Vjsw = 'gf_Php - gf_Tphp * (TEMP - gf_Tref)'
+ Tnom = 'gf_Tref'

dlts NP NN dio_lts_modn area=darea perim=dperi m=mp

.ends LTS_DIODE_N
* ****************************************************************************

* ****************************************************************************
* *** Equivalent LTSpice Model of a P+ Diode
* ****************************************************************************
.subckt LTS_DIODE_P NP NN darea=0 dperi=0 mp=0

.model pn_3p3 d
.param gf_Level=3
.param gf_Cj=0.00094344
.param gf_Mj=0.32084
.param gf_Pb=0.69939
.param gf_Cjsw=1.5078e-010
.param gf_Mjsw=0.05
.param gf_Php=0.8022
.param gf_Cta=0.00099187
.param gf_Ctp=0.00063483
.param gf_Tpb=0.0016906
.param gf_Tphp=0.0058423
.param gf_Tlevc=1
.param gf_Tref=25

.model dio_lts_modp d
+ Cj   = 'gf_Cj   * (1.0 + gf_Cta * (TEMP - gf_Tref))'
+ Cjsw = 'gf_Cjsw * (1.0 + gf_Ctp * (TEMP - gf_Tref))'
+ Mj   = 'gf_Mj'
+ Mjsw = 'gf_Mjsw'
+ Vj   = 'gf_Pb  - gf_Tpb  * (TEMP - gf_Tref)'
+ Vjsw = 'gf_Php - gf_Tphp * (TEMP - gf_Tref)'
+ Tnom = 'gf_Tref'

dlts NP NN dio_lts_modp area=darea perim=dperi m=mp

.ends LTS_DIODE_P
* ****************************************************************************


* ****************************************************************************
* *** Resistor Subckt - nplus_u
* ****************************************************************************
.subckt gfmcu_nplus_u ND NS NB wp=0 lp=0 ms=0 mp=0

.param wval='wp*1.0e-6'
.param lval='lp*1.0e-6'
.param sval='ms'
.param mval='mp'

.param r_dw='-5.0e-8*(1 + mc_dw_nplus_u * res_mc_skew * sw_stat_global)'
.param r_dl=0

.param r_w='(wval-2*r_dw)'
.param r_l='(lval-2*r_dl)*sval'

.param r_tnom=25
.param r_tc1=1.36e-3
.param r_tc2=6.5e-7

.param par_r=0.012608
.param par_sqrtarea='sqrt(mp*(r_l)*(r_w))'
.param var_r='0.7071*par_r*1e-06/par_sqrtarea'
.param mis_r=gauss(var_r)

.param r_rsh='rsh_nplus_u * (1+(mc_rsh_nplus_u/rsh_nplus_u)*res_mc_skew*sw_stat_global) * (1+mis_r*sw_stat_mismatch)'


.model model_rbody r
+ rsh=r_rsh
+ tc1=r_tc1
+ tc2=r_tc2
+ tnom=r_tnom
+ kf=2.4e-23
+ af=1.79
+ noise=0

.model model_rend r
+ rsh='18.5 + mc_rt_nplus_u*res_mc_skew*sw_stat_global'
+ tc1=8.5E-4
+ tc2=1.75E-6
+ tnom=25

rend1 ND  NDD model_rend   w=r_w l='sval*1u' m=mval
rbody NDD NSS model_rbody  w=r_w l=r_l     m=mval
rend2 NSS NS  model_rend   w=r_w l='sval*1u' m=mval

xd1 NB ND LTS_DIODE_N darea='r_w*r_l/2' dperi='r_w+2*r_l/2' mp=mval
xd2 NB NS LTS_DIODE_N darea='r_w*r_l/2' dperi='r_w+2*r_l/2' mp=mval


.ends gfmcu_nplus_u
* ****************************************************************************


* ****************************************************************************
* *** Resistor Subckt - pplus_u
* ****************************************************************************
.subckt gfmcu_pplus_u ND NS NB wp=0 lp=0 ms=0 mp=0

.param wval='wp*1.0e-6'
.param lval='lp*1.0e-6'
.param sval='ms'
.param mval='mp'

.param r_dw='2.75E-8*(1 + mc_dw_pplus_u * res_mc_skew * sw_stat_global)'
.param r_dl=0

.param r_w='(wval-2*r_dw)'
.param r_l='(lval-2*r_dl)*sval'

