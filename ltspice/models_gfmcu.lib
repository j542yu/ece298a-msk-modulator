* ***************************************
* autobuild begin : pmos3p3  
* ***************************************
* *****************************************************************
* *** File : models_gfmcu_base_pmos3p3.inc
* *** Rev  : 1.0 - (03/10/2023) 
* *****************************************************************
.subckt gfmcu_pmos3p3 ND NG NS NB wp=0 lp=0 np=0 mp=0

.param wval='wp*np*1.0e-6'
.param lval='lp*1.0e-6'
.param nval='np'
.param mval='mp'

.param wf='wp*1.0e-6'
.param lf='lp*1.0e-6'

* *************************
* GF statisical info
* *************************
.param par_w=-1e-7
.param par_l=1.5e-7

.param par_weff='(wf-par_w)*mval'
.param par_leff='(lf-par_l)'

.param par_vth=0.00666
* .param par_k=0.002833
.param p_sqrtarea='sqrt((par_leff)*(par_weff))'

.param var_vth='0.7071*par_vth* 1e-06 / p_sqrtarea'
* .param mis_vth=agauss(0,var_vth,1)
.param mis_vth=gauss(var_vth)

.param qrx_delvto = 'mis_vth*sw_stat_mismatch'
* *************************

.param np_dq='int((np-0)/2)'
.param np_sq='int((np-1)/2)'

.param np_dr='(np-0) - 2*np_dq'
.param np_sr='(np-1) - 2*np_sq'

.param qrx_ad = 'wf * (0.520e-6 * np_dq + 0.440e-6 * (0 + np_dr))'
.param qrx_as = 'wf * (0.520e-6 * np_sq + 0.440e-6 * (1 + np_sr))'

.param qrx_pd = '(2 * (0.520e-6 + wf) * np_dq + 2 * (0.440e-6 + wf) * (0 + np_dr))'
.param qrx_ps = '(2 * (0.520e-6 + wf) * np_sq + 2 * (0.440e-6 + wf) * (1 + np_sr))'

.param qrx_nrd = '0.26e-6/wval'
.param qrx_nrs = '0.26e-6/wval'

mpp ND NG NS NB pmos_3p3
+ w='wval'
+ l='lval'
+ nf='nval'
+ m='mval'
+ ad='qrx_ad'
+ as='qrx_as'
+ pd='qrx_pd'
+ ps='qrx_ps'
+ nrd='qrx_nrd'
+ nrs='qrx_nrs'
+ sa=0
+ sb=0
+ sd=0
+ sca=0
+ scb=0
+ scc=0
+ delvto='qrx_delvto'

* .ends gfmcu_pmos3p3
* (pmos_3p3 models go here, then add .ends)

